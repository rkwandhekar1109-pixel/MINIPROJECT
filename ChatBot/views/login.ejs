<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Chatbot — Authentication & Recovery</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/style.css">
  <style>
    .forgot-link-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: -6px;
      margin-bottom: 4px;
    }
    .forgot-link {
      font-size: 12.5px;
      color: var(--accent-primary);
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    .forgot-link:hover {
      text-decoration: underline;
      opacity: 0.9;
    }
    .email-sent-notice {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .email-sent-notice svg {
      width: 18px;
      height: 18px;
      color: var(--accent-primary);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .email-sent-notice strong {
      color: var(--text-primary);
      word-break: break-all;
    }
    .back-btn-wrapper {
      margin-top: 14px;
      text-align: center;
    }
    .back-to-login-btn {
      background: none;
      border: none;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
    }
    .back-to-login-btn:hover {
      color: var(--text-primary);
    }
    .step-badge {
      display: inline-block;
      padding: 3px 8px;
      background: var(--bg-secondary);
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
      color: var(--accent-primary);
      margin-bottom: 12px;
    }
  </style>
</head>
<body class="auth-body">
  <div class="auth-container">
    <!-- Brand Logo -->
    <div class="auth-brand">
      <div class="brand-icon-wrapper">
        <i data-lucide="sparkles" class="brand-icon"></i>
      </div>
      <h1 class="auth-title">AI Chatbot</h1>
      <p class="auth-subtitle">Intelligent conversations, vision analysis, & image generation</p>
    </div>

    <!-- Auth Card -->
    <div class="auth-card">
      <!-- Tabs (visible for login & signup) -->
      <div class="auth-tabs" id="auth-tabs">
        <button type="button" class="tab-btn <%= (typeof mode !== 'undefined' && mode === 'signup') ? '' : 'active' %>" id="tab-login" onclick="switchAuthMode('login')">
          <i data-lucide="log-in"></i> Log In
        </button>
        <button type="button" class="tab-btn <%= (typeof mode !== 'undefined' && mode === 'signup') ? 'active' : '' %>" id="tab-signup" onclick="switchAuthMode('signup')">
          <i data-lucide="user-plus"></i> Sign Up
        </button>
      </div>

      <!-- Inline Alert Box -->
      <div id="auth-alert" class="alert-box hidden" role="alert">
        <i data-lucide="alert-circle" class="alert-icon"></i>
        <span id="auth-alert-text"></span>
      </div>

      <!-- 1. LOGIN FORM -->
      <form id="login-form" class="auth-form <%= (typeof mode !== 'undefined' && mode === 'signup') ? 'hidden' : '' %>" onsubmit="handleLoginSubmit(event)">
        <div class="form-group">
          <label for="login-identifier">Email or Mobile Number</label>
          <div class="input-wrapper">
            <i data-lucide="user-check" class="input-icon"></i>
            <input type="text" id="login-identifier" name="identifier" placeholder="Email or 10-digit mobile" required autocomplete="username">
          </div>
          <span class="form-hint">Enter your registered email or 10-digit mobile number</span>
        </div>

        <div class="form-group">
          <label for="login-password">Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('login-password', this)" aria-label="Toggle password visibility">
              <i data-lucide="eye"></i>
            </button>
          </div>
        </div>

        <!-- Forgot Password Link -->
        <div class="forgot-link-wrapper">
          <a href="#" class="forgot-link" onclick="openForgotPassword(event)">Forgot Password?</a>
        </div>

        <button type="submit" id="login-submit-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Log In</span>
          <span class="spinner hidden"></span>
        </button>
      </form>

      <!-- 2. SIGNUP FORM -->
      <form id="signup-form" class="auth-form <%= (typeof mode !== 'undefined' && mode === 'signup') ? '' : 'hidden' %>" onsubmit="handleSignupSubmit(event)">
        <div class="form-group">
          <label for="signup-name">Full Name</label>
          <div class="input-wrapper">
            <i data-lucide="user" class="input-icon"></i>
            <input type="text" id="signup-name" name="name" placeholder="John Doe" required autocomplete="name">
          </div>
        </div>

        <div class="form-group">
          <label for="signup-email">Email Address</label>
          <div class="input-wrapper">
            <i data-lucide="mail" class="input-icon"></i>
            <input type="email" id="signup-email" name="email" placeholder="you@example.com" required autocomplete="email">
          </div>
        </div>

        <div class="form-group">
          <label for="signup-mobile">Mobile Number</label>
          <div class="input-wrapper">
            <i data-lucide="phone" class="input-icon"></i>
            <input type="tel" id="signup-mobile" name="mobileNumber" placeholder="+91 98765 43210" required autocomplete="tel">
          </div>
          <span class="form-hint">10-digit Indian mobile number (+91 optional)</span>
        </div>

        <div class="form-group">
          <label for="signup-password">Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="signup-password" name="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('signup-password', this)" aria-label="Toggle password visibility">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">Must be at least 6 characters long</span>
        </div>

        <div class="form-group">
          <label for="signup-confirm-password">Confirm Password</label>
          <div class="input-wrapper">
            <i data-lucide="check-circle" class="input-icon"></i>
            <input type="password" id="signup-confirm-password" name="confirmPassword" placeholder="Re-enter password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('signup-confirm-password', this)" aria-label="Toggle password visibility">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">Both passwords must match</span>
        </div>

        <button type="submit" id="signup-submit-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Create Account</span>
          <span class="spinner hidden"></span>
        </button>
      </form>

      <!-- 3. FORGOT PASSWORD STEP 1: Request OTP -->
      <form id="forgot-step1-form" class="auth-form hidden" onsubmit="handleSendOtp(event)">
        <div class="step-badge">Step 1 of 3: Account Recovery</div>
        <div class="form-group">
          <label for="forgot-email">Enter your registered email address</label>
          <div class="input-wrapper">
            <i data-lucide="mail" class="input-icon"></i>
            <input type="email" id="forgot-email" placeholder="you@example.com" required autocomplete="email">
          </div>
          <span class="form-hint">A secure 6-digit verification code will be sent to your email.</span>
        </div>

        <button type="submit" id="send-otp-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Send OTP</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper">
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>

      <!-- 4. FORGOT PASSWORD STEP 2: Verify 6-Digit OTP from Email -->
      <form id="forgot-step2-form" class="auth-form hidden" onsubmit="handleVerifyOtp(event)">
        <div class="step-badge">Step 2 of 3: Enter OTP</div>
        
        <!-- Notice confirming email sent -->
        <div class="email-sent-notice">
          <i data-lucide="mail-check"></i>
          <div>
            We sent a 6-digit verification OTP to <strong id="screen-user-email">your email</strong>. Valid for 10 minutes.
          </div>
        </div>

        <div class="form-group">
          <label for="otp-input">Enter OTP</label>
          <div class="input-wrapper">
            <i data-lucide="key-round" class="input-icon"></i>
            <input type="text" id="otp-input" placeholder="••••••" maxlength="6" pattern="\d{6}" required autocomplete="one-time-code" style="letter-spacing: 6px; font-weight: 700; font-size: 20px; text-align: center;">
          </div>
          <span class="form-hint">6-digit code is valid for 10 minutes</span>
        </div>

        <button type="submit" id="verify-otp-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Verify OTP</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper" style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
          <button type="button" id="resend-otp-btn" class="back-to-login-btn" onclick="handleResendOtp(event)">
            <i data-lucide="refresh-cw"></i> <span id="resend-btn-text">Resend OTP</span>
          </button>
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>

      <!-- 5. FORGOT PASSWORD STEP 3: Create New Password -->
      <form id="forgot-step3-form" class="auth-form hidden" onsubmit="handleResetPassword(event)">
        <div class="step-badge">Step 3 of 3: Create New Password</div>

        <div class="form-group">
          <label for="new-password">Create New Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="new-password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('new-password', this)">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">At least 6 characters</span>
        </div>

        <div class="form-group">
          <label for="confirm-password">Confirm Password</label>
          <div class="input-wrapper">
            <i data-lucide="check-circle" class="input-icon"></i>
            <input type="password" id="confirm-password" placeholder="Re-enter new password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('confirm-password', this)">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">Both passwords must match</span>
        </div>

        <button type="submit" id="reset-pw-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Reset Password</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper">
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>
    </div>

    <!-- Theme switch footer -->
    <div class="auth-footer">
      <button class="theme-toggle-btn" onclick="toggleTheme()" id="theme-toggle-btn" title="Toggle Theme">
        <i data-lucide="sun" id="theme-icon"></i>
      </button>
    </div>
  </div>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    let recoveryEmail = '';
    let activeResetToken = '';
    let cooldownTimer = null;
    let cooldownSecondsRemaining = 0;

    // Theme Management
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeIcon(savedTheme);

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeIcon(next);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('theme-icon');
      if (icon) {
        icon.setAttribute('data-lucide', theme === 'dark' ? 'sun' : 'moon');
        lucide.createIcons();
      }
    }

    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<i data-lucide="eye-off"></i>';
      } else {
        input.type = 'password';
        btn.innerHTML = '<i data-lucide="eye"></i>';
      }
      lucide.createIcons();
    }

    function hideAllForms() {
      document.getElementById('login-form').classList.add('hidden');
      document.getElementById('signup-form').classList.add('hidden');
      document.getElementById('forgot-step1-form').classList.add('hidden');
      document.getElementById('forgot-step2-form').classList.add('hidden');
      document.getElementById('forgot-step3-form').classList.add('hidden');
      document.getElementById('auth-alert').classList.add('hidden');
    }

    function switchAuthMode(mode) {
      hideAllForms();
      document.getElementById('auth-tabs').classList.remove('hidden');

      const tabLogin = document.getElementById('tab-login');
      const tabSignup = document.getElementById('tab-signup');

      if (mode === 'signup') {
        document.getElementById('signup-form').classList.remove('hidden');
        tabLogin.classList.remove('active');
        tabSignup.classList.add('active');
        window.history.replaceState({}, '', '/signup');
      } else {
        document.getElementById('login-form').classList.remove('hidden');
        tabSignup.classList.remove('active');
        tabLogin.classList.add('active');
        window.history.replaceState({}, '', '/login');
      }
      lucide.createIcons();
    }

    function openForgotPassword(e) {
      if (e) e.preventDefault();
      hideAllForms();
      document.getElementById('auth-tabs').classList.add('hidden');
      document.getElementById('forgot-step1-form').classList.remove('hidden');
      
      const loginIdVal = document.getElementById('login-identifier')?.value || '';
      if (loginIdVal && loginIdVal.includes('@')) {
        document.getElementById('forgot-email').value = loginIdVal;
      }
      document.getElementById('forgot-email').focus();
      lucide.createIcons();
    }

    function startResendCooldown(seconds = 45) {
      clearInterval(cooldownTimer);
      cooldownSecondsRemaining = seconds;
      const resendBtn = document.getElementById('resend-otp-btn');
      const resendText = document.getElementById('resend-btn-text');

      if (!resendBtn) return;
      resendBtn.disabled = true;
      resendBtn.style.opacity = '0.6';
      resendBtn.style.cursor = 'not-allowed';

      const updateText = () => {
        if (cooldownSecondsRemaining > 0) {
          resendText.textContent = `Resend in ${cooldownSecondsRemaining}s`;
          cooldownSecondsRemaining--;
        } else {
          clearInterval(cooldownTimer);
          resendText.textContent = 'Resend OTP';
          resendBtn.disabled = false;
          resendBtn.style.opacity = '1';
          resendBtn.style.cursor = 'pointer';
        }
      };

      updateText();
      cooldownTimer = setInterval(updateText, 1000);
    }

    // Step 1: Send OTP to Email
    async function handleSendOtp(e) {
      e.preventDefault();
      const email = document.getElementById('forgot-email').value.trim();
      const submitBtn = document.getElementById('send-otp-btn');
      
      if (!email) {
        showAlert('Please enter your registered email address.');
        return;
      }

      setBtnLoading(submitBtn, true, 'Sending OTP...');
      document.getElementById('auth-alert').classList.add('hidden');

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 20000);

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
          signal: controller.signal
        });
        clearTimeout(timeoutId);
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Failed to send OTP email.');
        } else {
          recoveryEmail = email;
          document.getElementById('screen-user-email').textContent = email;
          
          hideAllForms();
          document.getElementById('auth-tabs').classList.add('hidden');
          document.getElementById('forgot-step2-form').classList.remove('hidden');

          document.getElementById('otp-input').value = '';
          startResendCooldown(45);
          showAlert(data.message || 'OTP has been sent to your registered email address.', 'success');
          document.getElementById('otp-input').focus();
        }
      } catch (err) {
        if (err.name === 'AbortError') {
          showAlert('Request took longer than expected. Please check your connection or try again.');
        } else {
          showAlert('Network error: Could not reach the server. Please check your connection.');
        }
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    async function handleResendOtp(e) {
      if (e) e.preventDefault();
      const resendBtn = document.getElementById('resend-otp-btn');
      if (resendBtn.disabled) return;

      if (!recoveryEmail) {
        openForgotPassword();
        return;
      }

      const resendText = document.getElementById('resend-btn-text');
      resendText.textContent = 'Sending...';
      resendBtn.disabled = true;

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: recoveryEmail })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Failed to resend OTP.');
          resendText.textContent = 'Resend OTP';
          resendBtn.disabled = false;
        } else {
          startResendCooldown(45);
          showAlert(`New 6-digit OTP sent to ${recoveryEmail}. Please check your inbox.`, 'success');
          document.getElementById('otp-input').value = '';
          document.getElementById('otp-input').focus();
        }
      } catch (err) {
        showAlert('Network error: Could not resend OTP.');
        resendText.textContent = 'Resend OTP';
        resendBtn.disabled = false;
      }
    }

    // Step 2: Verify 6-Digit OTP
    async function handleVerifyOtp(e) {
      e.preventDefault();
      const otp = document.getElementById('otp-input').value.trim();
      const submitBtn = document.getElementById('verify-otp-btn');

      if (!otp || otp.length !== 6 || !/^\d{6}$/.test(otp)) {
        showAlert('Please enter the valid 6-digit numeric OTP from your email.');
        return;
      }

      setBtnLoading(submitBtn, true, 'Verifying OTP...');

      try {
        const res = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: recoveryEmail, otp })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Invalid OTP. Please check your email and try again.');
        } else {
          activeResetToken = data.resetToken || '';
          hideAllForms();
          document.getElementById('auth-tabs').classList.add('hidden');
          document.getElementById('forgot-step3-form').classList.remove('hidden');
          showAlert('OTP verified! Please create your new password.', 'success');
          document.getElementById('new-password').focus();
        }
      } catch (err) {
        showAlert('Network error. Could not verify OTP.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Step 3: Reset Password
    async function handleResetPassword(e) {
      e.preventDefault();
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-password').value;
      const submitBtn = document.getElementById('reset-pw-btn');

      if (!newPassword || !confirmPassword) {
        showAlert('Please fill in both password fields.');
        return;
      }

      if (newPassword !== confirmPassword) {
        showAlert('Passwords do not match.');
        return;
      }

      if (newPassword.length < 6) {
        showAlert('Password must be at least 6 characters long.');
        return;
      }

      setBtnLoading(submitBtn, true, 'Resetting Password...');

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: recoveryEmail,
            resetToken: activeResetToken,
            newPassword,
            confirmPassword
          })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Failed to update password.');
        } else {
          showAlert('Password reset successfully. You can now login with your new password.', 'success');
          setTimeout(() => {
            switchAuthMode('login');
            const loginId = document.getElementById('login-identifier');
            if (loginId) loginId.value = recoveryEmail;
            document.getElementById('login-password').value = '';
            document.getElementById('login-password').focus();
            showAlert('Password reset successfully. You can now login with your new password.', 'success');
          }, 1200);
        }
      } catch (err) {
        showAlert('Network error. Could not reset password.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Login Submission (Email OR Mobile Number)
    async function handleLoginSubmit(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('login-submit-btn');
      const identifier = document.getElementById('login-identifier').value.trim();
      const password = document.getElementById('login-password').value;

      if (!identifier || !password) {
        showAlert('Please enter your email/mobile and password.');
        return;
      }

      setBtnLoading(submitBtn, true, 'Logging in...');

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, password })
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Login failed. Please check your credentials.');
        } else {
          showAlert('Success! Redirecting to chat...', 'success');
          setTimeout(() => {
            window.location.href = '/';
          }, 600);
        }
      } catch (err) {
        showAlert('Network error. Could not connect to the server.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Signup Submission (Full Name, Email, Indian Mobile, Password, Confirm Password)
    async function handleSignupSubmit(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('signup-submit-btn');
      const name = document.getElementById('signup-name').value.trim();
      const email = document.getElementById('signup-email').value.trim();
      const mobileNumber = document.getElementById('signup-mobile').value.trim();
      const password = document.getElementById('signup-password').value;
      const confirmPassword = document.getElementById('signup-confirm-password').value;

      if (!name || !email || !mobileNumber || !password || !confirmPassword) {
        showAlert('Please fill in all fields.');
        return;
      }

      const emailRegex = /^\S+@\S+\.\S+$/;
      if (!emailRegex.test(email)) {
        showAlert('Please enter a valid email address.');
        return;
      }

      // Check Indian mobile format (+91 optional, 10 digits)
      const cleanedMobile = mobileNumber.replace(/[\s\-\(\)]/g, '');
      const validMobile = /^(?:\+91|91|0)?[6-9]\d{9}$/.test(cleanedMobile);
      if (!validMobile) {
        showAlert('Please enter a valid 10-digit Indian mobile number (+91 optional).');
        return;
      }

      if (password.length < 6) {
        showAlert('Password must be at least 6 characters long.');
        return;
      }

      if (password !== confirmPassword) {
        showAlert('Passwords do not match.');
        return;
      }

      setBtnLoading(submitBtn, true, 'Creating Account...');

      try {
        const res = await fetch('/api/auth/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, mobileNumber, password, confirmPassword })
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Registration failed. Please try again.');
        } else {
          showAlert('Account created successfully! Redirecting...', 'success');
          setTimeout(() => {
            window.location.href = '/';
          }, 600);
        }
      } catch (err) {
        showAlert('Network error. Could not connect to the server.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    function setBtnLoading(btn, isLoading, loadingText = '') {
      if (!btn) return;
      const btnText = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.spinner');
      btn.disabled = isLoading;
      if (isLoading) {
        if (loadingText && btnText) {
          btnText.textContent = loadingText;
          btnText.classList.remove('hidden');
        } else if (btnText) {
          btnText.classList.add('hidden');
        }
        if (spinner) spinner.classList.remove('hidden');
      } else {
        if (spinner) spinner.classList.add('hidden');
        if (btnText) {
          btnText.classList.remove('hidden');
          // Restore default button text based on button ID
          if (btn.id === 'login-submit-btn') btnText.textContent = 'Log In';
          if (btn.id === 'signup-submit-btn') btnText.textContent = 'Create Account';
          if (btn.id === 'send-otp-btn') btnText.textContent = 'Send OTP';
          if (btn.id === 'verify-otp-btn') btnText.textContent = 'Verify OTP';
          if (btn.id === 'reset-pw-btn') btnText.textContent = 'Reset Password';
        }
      }
    }

    function showAlert(message, type = 'error') {
      const alertBox = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');
      alertText.textContent = message;
      alertBox.classList.remove('hidden', 'alert-error', 'alert-success');
      alertBox.classList.add(type === 'success' ? 'alert-success' : 'alert-error');
      lucide.createIcons();
    }
  </script>
</body>
</html>
