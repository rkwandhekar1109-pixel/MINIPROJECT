<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Chatbot — Authentication & Recovery</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/style.css">
  <style>
    .forgot-link-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: -6px;
      margin-bottom: 4px;
    }
    .forgot-link {
      font-size: 12.5px;
      color: var(--accent-primary);
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    .forgot-link:hover {
      text-decoration: underline;
      opacity: 0.9;
    }
    .email-sent-notice {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .email-sent-notice svg {
      width: 18px;
      height: 18px;
      color: var(--accent-primary);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .email-sent-notice strong {
      color: var(--text-primary);
      word-break: break-all;
    }
    .back-btn-wrapper {
      margin-top: 14px;
      text-align: center;
    }
    .back-to-login-btn {
      background: none;
      border: none;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
    }
    .back-to-login-btn:hover {
      color: var(--text-primary);
    }
    .step-badge {
      display: inline-block;
      padding: 3px 8px;
      background: var(--bg-secondary);
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
      color: var(--accent-primary);
      margin-bottom: 12px;
    }
  </style>
</head>
<body class="auth-body">
  <div class="auth-container">
    <!-- Brand Logo -->
    <div class="auth-brand">
      <div class="brand-icon-wrapper">
        <i data-lucide="sparkles" class="brand-icon"></i>
      </div>
      <h1 class="auth-title">AI Chatbot</h1>
      <p class="auth-subtitle">Intelligent conversations, vision analysis, & image generation</p>
    </div>

    <!-- Auth Card -->
    <div class="auth-card">
      <!-- Tabs (visible for login & signup) -->
      <div class="auth-tabs" id="auth-tabs">
        <button type="button" class="tab-btn <%= (typeof mode !== 'undefined' && mode === 'signup') ? '' : 'active' %>" id="tab-login" onclick="switchAuthMode('login')">
          <i data-lucide="log-in"></i> Log In
        </button>
        <button type="button" class="tab-btn <%= (typeof mode !== 'undefined' && mode === 'signup') ? 'active' : '' %>" id="tab-signup" onclick="switchAuthMode('signup')">
          <i data-lucide="user-plus"></i> Sign Up
        </button>
      </div>

      <!-- Inline Alert Box -->
      <div id="auth-alert" class="alert-box hidden" role="alert">
        <i data-lucide="alert-circle" class="alert-icon"></i>
        <span id="auth-alert-text"></span>
      </div>

      <!-- 1. LOGIN FORM -->
      <form id="login-form" class="auth-form <%= (typeof mode !== 'undefined' && mode === 'signup') ? 'hidden' : '' %>" onsubmit="handleAuthSubmit(event, 'login')">
        <div class="form-group">
          <label for="login-email">Email Address</label>
          <div class="input-wrapper">
            <i data-lucide="mail" class="input-icon"></i>
            <input type="email" id="login-email" name="email" placeholder="you@example.com" required autocomplete="email">
          </div>
        </div>

        <div class="form-group">
          <label for="login-password">Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('login-password', this)" aria-label="Toggle password visibility">
              <i data-lucide="eye"></i>
            </button>
          </div>
        </div>

        <!-- Forgot Password Link -->
        <div class="forgot-link-wrapper">
          <a href="#" class="forgot-link" onclick="openForgotPassword(event)">Forgot Password?</a>
        </div>

        <button type="submit" id="login-submit-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Log In</span>
          <span class="spinner hidden"></span>
        </button>
      </form>

      <!-- 2. SIGNUP FORM -->
      <form id="signup-form" class="auth-form <%= (typeof mode !== 'undefined' && mode === 'signup') ? '' : 'hidden' %>" onsubmit="handleAuthSubmit(event, 'signup')">
        <div class="form-group">
          <label for="signup-email">Email Address</label>
          <div class="input-wrapper">
            <i data-lucide="mail" class="input-icon"></i>
            <input type="email" id="signup-email" name="email" placeholder="you@example.com" required autocomplete="email">
          </div>
        </div>

        <div class="form-group">
          <label for="signup-password">Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="signup-password" name="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('signup-password', this)" aria-label="Toggle password visibility">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">Must be at least 6 characters long</span>
        </div>

        <button type="submit" id="signup-submit-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Create Account</span>
          <span class="spinner hidden"></span>
        </button>
      </form>

      <!-- 3. FORGOT PASSWORD STEP 1: Request OTP -->
      <form id="forgot-step1-form" class="auth-form hidden" onsubmit="handleSendOtp(event)">
        <div class="step-badge">Step 1 of 3: Account Recovery</div>
        <div class="form-group">
          <label for="forgot-email">Enter Registered Email</label>
          <div class="input-wrapper">
            <i data-lucide="mail" class="input-icon"></i>
            <input type="email" id="forgot-email" placeholder="you@example.com" required>
          </div>
          <span class="form-hint">A secure 4-digit verification code will be sent to your email.</span>
        </div>

        <button type="submit" id="send-otp-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Send 4-Digit OTP to Email</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper">
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>

      <!-- 4. FORGOT PASSWORD STEP 2: Verify 4-Digit OTP from Email -->
      <form id="forgot-step2-form" class="auth-form hidden" onsubmit="handleVerifyOtp(event)">
        <div class="step-badge">Step 2 of 3: Enter OTP from Email</div>
        
        <!-- Notice confirming email sent -->
        <div class="email-sent-notice">
          <i data-lucide="mail-check"></i>
          <div>
            We sent a 4-digit OTP to <strong id="screen-user-email">your email</strong>. Please check your inbox (and spam folder) and enter it below.
          </div>
        </div>

        <div class="form-group">
          <label for="otp-input">Enter 4-Digit OTP</label>
          <div class="input-wrapper">
            <i data-lucide="key-round" class="input-icon"></i>
            <input type="text" id="otp-input" placeholder="••••" maxlength="4" pattern="\d{4}" required autocomplete="one-time-code" style="letter-spacing: 6px; font-weight: 700; font-size: 18px; text-align: center;">
          </div>
          <span class="form-hint">4-digit code is valid for 10 minutes</span>
        </div>

        <button type="submit" id="verify-otp-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Verify OTP</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper" style="display: flex; justify-content: space-between; align-items: center;">
          <button type="button" class="back-to-login-btn" onclick="openForgotPassword(event)">
            <i data-lucide="refresh-cw"></i> Resend OTP
          </button>
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>

      <!-- 5. FORGOT PASSWORD STEP 3: Create New Password & Confirm Password (only shown after OTP verified) -->
      <form id="forgot-step3-form" class="auth-form hidden" onsubmit="handleResetPassword(event)">
        <div class="step-badge">Step 3 of 3: Create New Password</div>

        <div class="form-group">
          <label for="new-password">Create New Password</label>
          <div class="input-wrapper">
            <i data-lucide="lock" class="input-icon"></i>
            <input type="password" id="new-password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('new-password', this)">
              <i data-lucide="eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm-password">Confirm Password</label>
          <div class="input-wrapper">
            <i data-lucide="check-circle" class="input-icon"></i>
            <input type="password" id="confirm-password" placeholder="Re-enter new password" required minlength="6" autocomplete="new-password">
            <button type="button" class="toggle-pw-btn" onclick="togglePasswordVisibility('confirm-password', this)">
              <i data-lucide="eye"></i>
            </button>
          </div>
          <span class="form-hint">Both passwords must match</span>
        </div>

        <button type="submit" id="reset-pw-btn" class="btn btn-primary btn-block">
          <span class="btn-text">Save New Password & Log In</span>
          <span class="spinner hidden"></span>
        </button>

        <div class="back-btn-wrapper">
          <button type="button" class="back-to-login-btn" onclick="switchAuthMode('login')">
            <i data-lucide="arrow-left"></i> Back to Log In
          </button>
        </div>
      </form>
    </div>

    <!-- Theme switch footer -->
    <div class="auth-footer">
      <button class="theme-toggle-btn" onclick="toggleTheme()" id="theme-toggle-btn" title="Toggle Theme">
        <i data-lucide="sun" id="theme-icon"></i>
      </button>
    </div>
  </div>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    let recoveryEmail = '';
    let activeResetToken = '';

    // Theme Management
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeIcon(savedTheme);

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeIcon(next);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('theme-icon');
      if (icon) {
        icon.setAttribute('data-lucide', theme === 'dark' ? 'sun' : 'moon');
        lucide.createIcons();
      }
    }

    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<i data-lucide="eye-off"></i>';
      } else {
        input.type = 'password';
        btn.innerHTML = '<i data-lucide="eye"></i>';
      }
      lucide.createIcons();
    }

    function hideAllForms() {
      document.getElementById('login-form').classList.add('hidden');
      document.getElementById('signup-form').classList.add('hidden');
      document.getElementById('forgot-step1-form').classList.add('hidden');
      document.getElementById('forgot-step2-form').classList.add('hidden');
      document.getElementById('forgot-step3-form').classList.add('hidden');
      document.getElementById('auth-alert').classList.add('hidden');
    }

    function switchAuthMode(mode) {
      hideAllForms();
      document.getElementById('auth-tabs').classList.remove('hidden');

      const tabLogin = document.getElementById('tab-login');
      const tabSignup = document.getElementById('tab-signup');

      if (mode === 'signup') {
        document.getElementById('signup-form').classList.remove('hidden');
        tabLogin.classList.remove('active');
        tabSignup.classList.add('active');
        window.history.replaceState({}, '', '/signup');
      } else {
        document.getElementById('login-form').classList.remove('hidden');
        tabSignup.classList.remove('active');
        tabLogin.classList.add('active');
        window.history.replaceState({}, '', '/login');
      }
      lucide.createIcons();
    }

    function openForgotPassword(e) {
      if (e) e.preventDefault();
      hideAllForms();
      document.getElementById('auth-tabs').classList.add('hidden');
      document.getElementById('forgot-step1-form').classList.remove('hidden');
      
      const loginEmailVal = document.getElementById('login-email').value;
      if (loginEmailVal) {
        document.getElementById('forgot-email').value = loginEmailVal;
      }
      document.getElementById('forgot-email').focus();
      lucide.createIcons();
    }

    // Step 1: Send OTP to Email
    async function handleSendOtp(e) {
      e.preventDefault();
      const email = document.getElementById('forgot-email').value.trim();
      const submitBtn = document.getElementById('send-otp-btn');
      
      if (!email) {
        showAlert('Please enter your registered email address.');
        return;
      }

      setBtnLoading(submitBtn, true);
      document.getElementById('auth-alert').classList.add('hidden');

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 25000);

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
          signal: controller.signal
        });
        clearTimeout(timeoutId);
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Failed to send OTP email.');
        } else {
          recoveryEmail = email;
          document.getElementById('screen-user-email').textContent = email;
          
          hideAllForms();
          document.getElementById('auth-tabs').classList.add('hidden');
          document.getElementById('forgot-step2-form').classList.remove('hidden');

          document.getElementById('otp-input').value = '';
          showAlert(`A 4-digit OTP has been sent to ${email}. Please check your inbox and enter it below!`, 'success');
          document.getElementById('otp-input').focus();
        }
      } catch (err) {
        if (err.name === 'AbortError') {
          showAlert('Request took longer than expected. Please check your connection or try again.');
        } else {
          showAlert('Network error: Could not reach the server. Please check your connection.');
        }
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Step 2: Verify OTP entered by user
    async function handleVerifyOtp(e) {
      e.preventDefault();
      const otp = document.getElementById('otp-input').value.trim();
      const submitBtn = document.getElementById('verify-otp-btn');

      if (!otp || otp.length !== 4) {
        showAlert('Please enter the 4-digit OTP from your email.');
        return;
      }

      setBtnLoading(submitBtn, true);

      try {
        const res = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: recoveryEmail, otp })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Invalid 4-digit OTP. Please check your email and try again.');
        } else {
          activeResetToken = data.resetToken || '';
          hideAllForms();
          document.getElementById('auth-tabs').classList.add('hidden');
          document.getElementById('forgot-step3-form').classList.remove('hidden');
          showAlert('OTP verified! Please create your new password.', 'success');
          document.getElementById('new-password').focus();
        }
      } catch (err) {
        showAlert('Network error. Could not verify OTP.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Step 3: Create New Password & Confirm Password
    async function handleResetPassword(e) {
      e.preventDefault();
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-password').value;
      const submitBtn = document.getElementById('reset-pw-btn');

      if (!newPassword || !confirmPassword) {
        showAlert('Please fill in both password fields.');
        return;
      }

      if (newPassword !== confirmPassword) {
        showAlert('New password and confirm password do not match.');
        return;
      }

      if (newPassword.length < 6) {
        showAlert('Password must be at least 6 characters long.');
        return;
      }

      setBtnLoading(submitBtn, true);

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: recoveryEmail,
            resetToken: activeResetToken,
            newPassword,
            confirmPassword
          })
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Failed to update password.');
        } else {
          showAlert('Password updated successfully! Redirecting to login...', 'success');
          setTimeout(() => {
            switchAuthMode('login');
            document.getElementById('login-email').value = recoveryEmail;
            document.getElementById('login-password').value = '';
            document.getElementById('login-password').focus();
            showAlert('Password reset successful! You can now log in with your new password.', 'success');
          }, 1000);
        }
      } catch (err) {
        showAlert('Network error. Could not reset password.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    // Login & Signup Submission
    async function handleAuthSubmit(e, mode) {
      e.preventDefault();
      const submitBtn = document.getElementById(`${mode}-submit-btn`);
      const email = document.getElementById(`${mode}-email`).value.trim();
      const password = document.getElementById(`${mode}-password`).value;

      if (!email || !password) {
        showAlert('Please fill in all fields.');
        return;
      }

      if (mode === 'signup' && password.length < 6) {
        showAlert('Password must be at least 6 characters long.');
        return;
      }

      setBtnLoading(submitBtn, true);

      try {
        const endpoint = mode === 'signup' ? '/api/auth/signup' : '/api/auth/login';
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          showAlert(data.error || 'Authentication failed. Please try again.');
        } else {
          showAlert(mode === 'signup' ? 'Account created! Redirecting...' : 'Success! Redirecting...', 'success');
          setTimeout(() => {
            window.location.href = '/';
          }, 600);
        }
      } catch (err) {
        showAlert('Network error. Could not connect to the server.');
      } finally {
        setBtnLoading(submitBtn, false);
      }
    }

    function setBtnLoading(btn, isLoading) {
      const btnText = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.spinner');
      btn.disabled = isLoading;
      if (isLoading) {
        btnText.classList.add('hidden');
        spinner.classList.remove('hidden');
      } else {
        btnText.classList.remove('hidden');
        spinner.classList.add('hidden');
      }
    }

    function showAlert(message, type = 'error') {
      const alertBox = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');
      alertText.textContent = message;
      alertBox.classList.remove('hidden', 'alert-error', 'alert-success');
      alertBox.classList.add(type === 'success' ? 'alert-success' : 'alert-error');
      lucide.createIcons();
    }
  </script>
</body>
</html>
